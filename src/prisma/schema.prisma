  author     String   @db.VarChar(200)
  audio_path String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model book_meta {
  uuid        String   @id @db.VarChar(100)
  user_id     String   @db.VarChar(100)
  title       String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
}

model book_chapter {
  uuid        String   @id @db.VarChar(100)
  book_uuid   String   @db.VarChar(100)
  parent_uuid String?  @db.VarChar(100)
  order_num   Int
  title       String
  status      String?  @db.VarChar(20)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
}

model book_sentence {
  uuid          String   @id @db.VarChar(100)
  chapter_uuid  String   @db.VarChar(100)
  user_id       String   @db.VarChar(100)
  order_num     Int
  content       String
  sentence_type String   @db.VarChar(20)
  audio_path    String?
  recognized    String?
  bg_color      String?  @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
}

model book_sentence_word {
  uuid           String   @id @db.VarChar(100)
  sentence_uuid  String   @db.VarChar(100)
  word           String
  word_type      String   @db.VarChar(20)
  note           String
}

// Per-user chapter progress for dataset-backed books. The dataset's own
// book_chapter.status is shared content and is never written from the web; this
// table holds the caller's own completion state, keyed by dataset + chapter.
model read_chapter_progress {
  uuid         String   @id @db.VarChar(100)
  user_id      String   @db.VarChar(100)
  dataset_uuid String   @db.VarChar(100)
  chapter_uuid String   @db.VarChar(100)
  status       String   @db.VarChar(20)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, dataset_uuid, chapter_uuid])
}

// ---------- card

model qsa_card {
  uuid          String   @id @db.VarChar(100)
  user_id       String   @db.VarChar(100)
  question      String
  suggestion    String
  answer        String
  familiarity   Int
  note          String
  question_hash String?  @db.VarChar(100)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([question_hash])
}

model qsa_card_review {
  uuid           String   @id @db.VarChar(100)
  user_id        String   @db.VarChar(255)
  card_uuid      String   @db.VarChar(100)
  familiarity    Int
  interval_days  Int
  ease_factor    Int
  repetitions    Int
  last_review_at DateTime @db.Timestamptz(6)
  next_review_at DateTime @db.Timestamptz(6)
}

model qsa_card_tag {
  uuid       String   @id @db.VarChar(100)
  card_uuid  String   @db.VarChar(100)
  tag_uuid   String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model qsa_card_improve {
  uuid           String   @id @db.VarChar(100)
  user_id        String   @db.VarChar(255)
  card_uuid      String   @db.VarChar(100)
  current        String
  improved       String
  status         String
  note           String
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
}

// ---------- shared services

model shared_service {
  uuid         String   @id @db.VarChar(100)
  user_id      String   @db.VarChar(100)
  name         String   @db.VarChar(200)
  service_type String   @db.VarChar(20)
  url          String   @db.VarChar(500)
  description  String   @default("")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
}