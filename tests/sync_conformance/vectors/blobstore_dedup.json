    {
      "op": "diff",
      "dataset": "aaaaaaaa-0001-4001-8001-000000000001",
      "refs": [
        { "path": "f1", "sha256": "1111111111111111111111111111111111111111111111111111111111111111", "size": 10 },
        { "path": "f3", "sha256": "4444444444444444444444444444444444444444444444444444444444444444", "size": 40 }
      ],
      "expect_need": [
        "4444444444444444444444444444444444444444444444444444444444444444"
      ],
      "note": "sha1 already in the store -> nothing to upload for it, only sha4 is needed"
