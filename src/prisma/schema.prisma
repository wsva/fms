generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

// ---------- auth

model oauth2_token {
  access_token  String  @id @db.VarChar(1000)
  refresh_token String  @db.VarChar(1000)
  client_id     String  @db.VarChar(100)
  user_id       String  @db.VarChar(100)
  ip            String  @db.VarChar(100)
  parent        String? @db.VarChar(1000)
}

model oauth2_user {
  user_id      String  @id @db.VarChar(100)
  nickname     String? @db.VarChar(100)
  username     String? @db.VarChar(100)
  number       String? @db.VarChar(100)
  email        String  @db.VarChar(100)
  password     String  @db.VarChar(100)
  is_superuser String  @db.VarChar(1)
  is_staff     String  @db.VarChar(1)
  is_active    String  @db.VarChar(1)
}

// ---------- settings

model settings_general {
  id         Int      @id @default(autoincrement())
  user_id    String   @db.VarChar(100)
  key        String   @db.VarChar(100)
  value      String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, key])
}

model settings_api_key {
  uuid       String   @id @db.VarChar(100)
  user_id    String   @db.VarChar(100)
  name       String   @db.VarChar(100)
  key_hash   String   @unique @db.VarChar(64)
  scope      String   @default("write") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

// ---------- plan

model plan_plan {
  uuid       String   @id @db.VarChar(100)
  user_id    String   @db.VarChar(100)
  content    String
  minutes    Int
  favorite   String?  @db.VarChar(1)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model plan_record {
  uuid       String    @id @db.VarChar(100)
  user_id    String    @db.VarChar(100)
  plan_uuid  String    @db.VarChar(100)
  start_at   DateTime? @db.Timestamptz(6)
  status     String    @db.VarChar(100)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
}

// ---------- dataset

model dataset_tag {
  uuid        String   @id @db.VarChar(100)
  user_id     String   @db.VarChar(100)
  tag         String
  description String
  parent_uuid String?  @db.VarChar(100)
  shared      String   @default("N") @db.VarChar(1)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
}

model dataset_subscription {
  uuid         String   @id @db.VarChar(100)
  user_id      String   @db.VarChar(100)
  tag_uuid     String?  @db.VarChar(100)
  dataset_uuid String?  @db.VarChar(100)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, dataset_uuid])
}

model dataset_scope {
  uuid String @id @db.VarChar(100)
}

model dataset_tag_scope {
  uuid       String   @id @db.VarChar(100)
  tag_uuid   String   @db.VarChar(100)
  scope_uuid String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tag_uuid, scope_uuid])
}

// ---------- dataset hub (fms-app dataset directories)

/*
Catalog row per dataset directory (uploaded as tar.gz, extracted live under
DATASET_ROOT). Fields mirror the app's info.json spec v2; info_* stamps stay
strings in canonical UTC second-precision form, never timestamptz.
*/
model dataset {
  uuid            String   @id @db.VarChar(100)
  user_id         String   @db.VarChar(100)
  name            String
  description     String   @default("")
  dataset_type    String   @db.VarChar(20)
  format          String   @db.VarChar(40)
  language        String   @default("") @db.VarChar(10)
  spec            Int      @default(2)
  visibility      String   @default("private") @db.VarChar(10)
  extra           Json?
  info_created_at String?  @db.VarChar(32)
  info_updated_at String?  @db.VarChar(32)
  status          String   @default("ready") @db.VarChar(20)
  archive_path    String?
  archive_sha256  String?  @db.VarChar(64)
  archive_size    BigInt?
  file_count      Int      @default(0)
  total_bytes     BigInt   @default(0)
  overall_hash    String?  @db.VarChar(64)
  snapshot_seq    BigInt   @default(0)
  // Published pin (sync-v2 §7/§8.4, INV-8/INV-17): the dataset_version.registry
  // reads resolve to. NULL = nothing published, so registry reads 404. Only an
  // explicit publish moves it; an upload or card push updates the live mirror and
  // snapshot_seq but never this, so subscribers never see un-published edits.
  current_version Int?
  media_count     Int      @default(0)
  card_count      Int      @default(0)
  // sync-v2 phase 7b: this scope's journal role. 'mirror' = the desktop hub owns
  // the dataset-scope journal and the website stores its seqs verbatim (POST
  // /api/v1/changes); 'authority' = this website mints the scope's journal seq
  // (POST /api/v1/sync/changes) and a stale hub's mirror push into it is refused
  // (INV-1/INV-13). Flipped only by an operator/handover, never implicitly by a
  // push. journal_epoch is the per-scope handover epoch — minted 0, surfaced in
  // mirror refusals, nothing bumps it until handover export/import ships.
  journal_role    String   @default("mirror") @db.VarChar(10)
  journal_epoch   Int      @default(0)
  deleted         String   @default("N") @db.VarChar(1)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([dataset_type])
  @@index([visibility, deleted])
  @@index([user_id])
}

/*
Immutable per-version upload record: the bytes + hashes of one v<N>.tar.gz under
_archive/. Registry reads serve the version named by dataset.current_version (the
pin), independent of the live dir — a later upload adds a row here but does not
move the pin, so a published version stays immutable (INV-8/INV-17).
*/
model dataset_version {
  uuid            String   @id @db.VarChar(100)
  dataset_uuid    String   @db.VarChar(100)
  version         Int
  archive_path    String
  archive_sha256  String   @db.VarChar(64)
  archive_size    BigInt
  file_count      Int      @default(0)
  total_bytes     BigInt   @default(0)
  overall_hash    String?  @db.VarChar(64)
  info_updated_at String?  @db.VarChar(32)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([dataset_uuid, version])
  @@index([dataset_uuid])
}

/*
Manifest per-file hash cache keyed (dataset, path); rehash only when the
(size, mtime) tuple changes.
*/
model dataset_file_hash {
  dataset_uuid String   @db.VarChar(100)
  path         String   @db.VarChar(1024)
  size         BigInt
  mtime        BigInt
  sha256       String   @db.VarChar(64)

  @@id([dataset_uuid, path])
}

/* Grouping only — links a dataset directory to legacy dataset_tag rows. */
model dataset_tag_link {
  uuid         String   @id @db.VarChar(100)
  dataset_uuid String   @db.VarChar(100)
  tag_uuid     String   @db.VarChar(100)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([dataset_uuid, tag_uuid])
  @@index([tag_uuid])
}

// ---------- sync-v2 @app cloud authority (phase 7a)

/*
Per-cluster seq minter. `seq` is monotonic within a cluster (cluster_id =
account email; the website hosts one cloud cluster per account), not globally,
because one Postgres serves every account. Advanced under a per-cluster advisory
xact lock so appends serialize across instances (sync-v2.md §11.2).
*/
model app_sync_seq {
  cluster_id String @id @db.VarChar(320)
  next_seq   BigInt @default(1)
}

/*
Per-scope dataset seq minter (sync-v2.md phase 7b). The dataset-scope analogue of
app_sync_seq: it mints a monotonic seq per (cluster_id, dataset uuid) journal, but
SELF-SEEDS above any hub-mirrored rows already in app_sync_log for that scope
(see nextDatasetSeq), so a mirror→authority handover CONTINUES the sequence
instead of restarting at 1 and colliding with the mirrored number space (§9 flow
8). The @app minter above is untouched — the live cloud-authority path has zero
regression risk from this per-scope counter.
*/
model dataset_sync_seq {
  cluster_id String @db.VarChar(320)
  scope      String @db.VarChar(100)
  next_seq   BigInt @default(1)

  @@id([cluster_id, scope])
}

/*
Append-only change journal. Holds TWO seq number spaces under one cluster_id,
disambiguated by `scope` (sync-v2.md §3-fact-2 / §6.1):
  - scope='@app' — the website-MINTED cloud-authority journal (dictation, xp,
    card_review); seq comes from app_sync_seq via nextSeq (INV-1).
  - scope=<dataset uuid> — hub-MIRRORED dataset entries; the hub's seq is stored
    verbatim, never re-minted (a mirror reproduces the authority's journal).
Both spaces start at 1, so the PK must include `scope` or they collide.
*/
model app_sync_log {
  cluster_id String   @db.VarChar(320)
  seq        BigInt
  scope      String   @db.VarChar(100)
  object_id  String
  kind       String   @db.VarChar(40)
  op         String   @db.VarChar(10)
  edit_time  String   @default("") @db.VarChar(64)
  user_key   String   @default("") @db.VarChar(320)
  payload    Json
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([cluster_id, scope, seq])
}

/*
Replay dedup ledger (INV-3): a lost ack makes the follower re-send the same
change_id; the hub applies it once. Keyed per cluster so one account's id can
never shadow another's. Pruned by applied_at, never by edit_time.
*/
model app_applied_change {
  cluster_id String   @db.VarChar(320)
  change_id  String   @db.VarChar(128)
  applied_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([cluster_id, change_id])
  @@index([cluster_id, applied_at])
}

/*
Retention high-water mark per (cluster, scope). A follower cursoring below it
has an unrecoverable gap and is told `resync_required` on its next pull.
*/
model app_sync_prune_mark {
  cluster_id   String @db.VarChar(320)
  scope        String @db.VarChar(100)
  pruned_up_to BigInt @default(0)

  @@id([cluster_id, scope])
}

/*
dictation progress projection (State, later-edit_time-wins). `completed` is a
String on the wire (`ListenDictation.completed`), so it stays text here.
*/
model app_dictation {
  id            BigInt   @id @default(autoincrement())
  cluster_id    String   @db.VarChar(320)
  media_uuid    String   @db.VarChar(100)
  subtitle_uuid String   @db.VarChar(100)
  status        String   @default("") @db.VarChar(20)
  completed     String   @default("")
  edit_time     String   @default("") @db.VarChar(64)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([cluster_id, media_uuid, subtitle_uuid])
}

/*
XP ledger (Counter): one delta row per award; lifetime_xp = SUM(amount) (INV-16,
recomputed, never accumulated). The unique key is exactly the dedup key the app's
`xp_award_internal` checks, so a replayed award is a no-op.
*/
model app_xp_ledger {
  id           BigInt   @id @default(autoincrement())
  cluster_id   String   @db.VarChar(320)
  amount       BigInt
  source       String   @default("") @db.VarChar(60)
  reference_id String   @default("") @db.VarChar(128)
  dataset_uuid String   @default("") @db.VarChar(100)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([cluster_id, source, reference_id, dataset_uuid])
}

/*
card-review results (AppendOnly; INV-21 non-prunable). One stored result per
rating, keyed by the author's event_uuid so a replayed event is inserted once.
*/
model app_card_review_event {
  id             BigInt   @id @default(autoincrement())
  cluster_id     String   @db.VarChar(320)
  event_uuid     String   @db.VarChar(100)
  user_id        String   @default("") @db.VarChar(320)
  dataset_uuid   String   @default("") @db.VarChar(100)
  card_uuid      String   @db.VarChar(100)
  quality        Int?
  reviewed_at    String?  @db.VarChar(64)
  familiarity    Int      @default(0)
  interval_days  Int      @default(0)
  ease_factor    Int      @default(250)
  repetitions    Int      @default(0)
  next_review_at String?  @db.VarChar(64)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([cluster_id, event_uuid])
}

/*
Read-aloud attempt events (sync-v2.md §17.6 item 3, protocol v6): per-user practice
history journaled under `@app` as kind `read_attempt_save` and projected here. One
row per attempt, carrying its outcome (INV-23) — the unique key `(cluster_id, uuid)`
makes a replayed event an INSERT-once no-op, mirroring the app's
`INSERT OR IGNORE INTO read_attempt_event` keyed by its uuid PK.

`audio_path` is device-local (the row syncs, the WAV does not). `created_at` is the
WIRE stamp from `attempt_payload` (the attempt's own time, canonical fixed-width UTC
per INV-6) — NOT the ingest time, which is `inserted_at`; the column keeps the wire
name so the payload/state mapping stays 1:1 with the app's `read_attempt_event`.
*/
model app_read_attempt_event {
  id           BigInt   @id @default(autoincrement())
  cluster_id   String   @db.VarChar(320)
  uuid         String   @db.VarChar(100)
  user_id      String   @default("") @db.VarChar(320)
  dataset_uuid String   @default("") @db.VarChar(100)
  text_uuid    String   @default("") @db.VarChar(100)
  audio_path   String?
  recognized   String   @default("")
  score        Float    @default(0)
  created_at   String   @default("") @db.VarChar(64)
  inserted_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([cluster_id, uuid])
}

/*
Inbox proposal-ordering counter, per (cluster, scope). Mirrors the `app_sync_seq`
shape but is a SEPARATE number space: `proposal_seq` orders the proposal queue, it
is NEVER a journal seq (sync-v2.md INV-1 — only the authority mints journal seq, and
the website is not the dataset-scope authority). The desktop hub mints the real
journal seq when it drains a proposal through its command path (§8.3 step 2).
*/
model app_inbox_seq {
  cluster_id String @db.VarChar(320)
  scope      String @db.VarChar(100)
  next_seq   BigInt @default(1)

  @@id([cluster_id, scope])
}

/*
Inbox proposal queue (sync-v2.md §6.3, §8.3, §14 step 5). The website HOSTS
proposals from editors without the journal (the website UI; optionally an offline
follower); the desktop authority drains them, applies via its command path (INV-18,
minting the real journal seq THERE), and acks accepted[]/rejected[{winner_seq,
winner_payload}] (INV-4).

This is a QUEUE with a lifecycle (pending -> accepted | rejected), NOT an
append-only journal, so INV-2 does not apply here — updating `status` on ack is the
queue's purpose. The journal (`app_sync_log`) is never written by this table's
routes (INV-1, INV-17).

`proposal_seq` is an inbox-ordering counter per (cluster, scope) from
`app_inbox_seq`, NOT a journal position. `change_id` is the INV-3 dedup key (a
re-propose is a no-op). `winner_seq`/`winner_payload` are the INV-4 rollback
material: on a rejected ack they hold the authoritative row so the website UI can
roll its optimistic `live/` write back; on an accepted ack `winner_seq` records the
journal seq the authority minted (for traceability only — never minted here).
*/
model app_inbox {
  cluster_id     String    @db.VarChar(320)
  scope          String    @db.VarChar(100)
  proposal_seq   BigInt
  change_id      String    @db.VarChar(128)
  object_id      String
  kind           String    @db.VarChar(40)
  op             String    @db.VarChar(10)
  edit_time      String    @default("") @db.VarChar(64)
  author         String    @default("") @db.VarChar(320)
  payload        Json
  status         String    @default("pending") @db.VarChar(10)
  winner_seq     BigInt?
  winner_payload Json?
  acked_at       DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@id([cluster_id, scope, proposal_seq])
  @@unique([cluster_id, change_id])
  @@index([cluster_id, scope, status, proposal_seq])
}

