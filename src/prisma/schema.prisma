}

model listen_subtitle_cue {
  uuid          String   @id @db.VarChar(100)
  subtitle_uuid String   @db.VarChar(100)
  order_num     Int
  start_ms      Int
  end_ms        Int
  content       String
  reference     String?
}

/*
A book contains the text of all audios.

The format of a book maybe not good, with hyphens, new-lines and trivial texts.

We must use STT models to generate subtitles, but we can reference the book to correct the subtitles, we cannot know which one is better.

If a cue exists exactly in the book, then it's perfect. If there is only a similiar text in the book, we give the two texts to the user, let the user decide which one is correct.

In the database, we call the full text of a book as a chunk. It's just a chunk of contents, we don't treat it as a well formated book.
*/
model listen_subtitle_reference {
  uuid       String   @id @db.VarChar(100)
  chunk_uuid String   @db.VarChar(100)
  order_num  Int
  content    String
  cue_uuid   String?
}

model listen_transcript {
  uuid       String   @id @db.VarChar(100)
  user_id    String   @db.VarChar(100)
  media_uuid String   @db.VarChar(100)
  language   String   @db.VarChar(10)
  transcript String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model listen_dictation {
  uuid          String   @id @db.VarChar(100)
  user_id       String   @db.VarChar(100)
  media_uuid    String   @db.VarChar(100)
  subtitle_uuid String   @db.VarChar(100)
  status        String   @db.VarChar(20)
  completed     String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, media_uuid, subtitle_uuid])
}

