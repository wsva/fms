      "refs": [
        { "path": "g1", "sha256": "1111111111111111111111111111111111111111111111111111111111111111", "size": 10 },
        { "path": "g2", "sha256": "3333333333333333333333333333333333333333333333333333333333333333", "size": 30 }
      ],
      "expect_applied": 2
    },
    {
      "op": "refcount",
